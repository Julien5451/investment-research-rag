# Copy to .env inside this repository. Settings are case-insensitive.
# Chat and embeddings can use entirely different servers, models and keys.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# For an OpenAI-compatible local/third-party endpoint, set the corresponding
# PROVIDER=openai-compatible, BASE_URL (including /v1 if needed), and MODEL.
# Blank keys are allowed for compatible servers that do not require credentials.
# Standard /chat/completions and /embeddings APIs are required.

DATA_DIR=./data
COLLECTION_NAME=research
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=2000000
# Chunk sizes and overlap are characters, not tokens. Pages are never merged.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
MIN_RELEVANCE_SCORE=0.35
MAX_CONTEXT_CHARS=16000
REQUEST_TIMEOUT_SECONDS=60

# Streamlit reads QA_API_URL from its shell environment, not from this .env:
# QA_API_URL=http://127.0.0.1:8000 uv run --extra demo streamlit run streamlit_app.py
